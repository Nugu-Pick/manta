SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=manta-api
AUTH_JWT_SECRET=change-me-with-at-least-32-random-bytes
AUTH_REFRESH_TOKEN_TTL=P30D
AUTH_REFRESH_COOKIE_NAME=manta_refresh_token
AUTH_OAUTH_STATE_COOKIE_NAME=manta_oauth_state
AUTH_OAUTH_VERIFIER_COOKIE_NAME=manta_oauth_verifier
AUTH_FRONTEND_CALLBACK_URI=http://localhost:3000/auth/callback
AUTH_OAUTH_AUTHORIZATION_TTL=PT10M

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/google/callback

KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
